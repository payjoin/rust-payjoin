{
    "name": "payjoin-rn",
    "version": "0.1.4",
    "description": "React Native bindings for rust-payjoin (EXPERIMENTAL)",
    "homepage": "https://github.com/payjoin/rust-payjoin#readme",
    "author": "xstoicunicornx <xstoicunicornx@users.noreply.github.com>",
    "react-native": "./src/index.tsx",
    "main": "./lib/module/index.js",
    "types": "./lib/typescript/index.d.ts",
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "PayjoinRnFramework.xcframework",
        "!**/build",
        "!**/__tests__",
        "!**/.*"
    ],
    "scripts": {
        "ubrn:checkout": "ubrn checkout --config ubrn.config.yaml",
        "ubrn:android": "ubrn build android --release --and-generate --config ubrn.config.yaml",
        "ubrn:ios": "ubrn build ios --release --and-generate --config ubrn.config.yaml",
        "build": "bob build",
        "prepack": "bash ./scripts/check_artifacts.sh",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf lib rust_modules cpp android ios *.podspec src/generated src/index.tsx src/Native*.ts"
    },
    "keywords": [
        "payjoin",
        "bitcoin",
        "react-native",
        "ios",
        "android",
        "rust"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/payjoin/rust-payjoin.git",
        "directory": "payjoin-ffi/react-native"
    },
    "license": "MIT OR Apache-2.0",
    "peerDependencies": {
        "react": ">=18.2.0",
        "react-native": ">=0.76.0"
    },
    "dependencies": {
        "@ubjs/core": "^0.31.0-3",
        "uniffi-bindgen-react-native": "github:spacebear21/uniffi-bindgen-react-native#d10f04d83299"
    },
    "devDependencies": {
        "@types/react": "19.0.0",
        "prettier": "3.6.2",
        "react": "19.0.0",
        "react-native": "0.79.2",
        "react-native-builder-bob": "0.40.10",
        "typescript": "5.9.3"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "codegenConfig": {
        "name": "PayjoinRnSpec",
        "type": "modules",
        "jsSrcsDir": "src",
        "android": {
            "javaPackageName": "org.payjoindevkit"
        }
    }
}
